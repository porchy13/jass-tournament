<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<!--
  The control of the external display (DisplayController): the window and its screen, the round in progress with its
  start signal, the final ranking revealed line by line.
-->
<VBox styleClass="view" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
  <HBox styleClass="toolbar">
    <Button fx:id="openButton" minWidth="-Infinity" styleClass="primary" text="%display.open" onAction="#openWindow"/>
    <Button fx:id="closeButton" minWidth="-Infinity" text="%display.close" onAction="#closeWindow"/>
  </HBox>
  <ScrollPane styleClass="panel" fitToWidth="true" VBox.vgrow="ALWAYS">
    <VBox styleClass="view-body">
      <HBox styleClass="view-head">
        <Label fx:id="title" styleClass="title-view"/>
        <Label fx:id="settings" styleClass="caption"/>
      </HBox>
      <Label styleClass="section-head" text="%display.window"/>
      <GridPane styleClass="form">
        <Label styleClass="field-label" text="%display.screen.label" labelFor="$screenChoice"
               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="screenChoice" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <CheckBox fx:id="fullScreen" text="%display.fullscreen" onAction="#placeWindow"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>
      </GridPane>
      <VBox fx:id="empty" styleClass="empty-state">
        <Label text="%display.empty"/>
        <Button fx:id="registrationButton" text="%schedule.registration" onAction="#showRegistration"/>
      </VBox>
      <VBox fx:id="controls" styleClass="slots">
        <VBox styleClass="slot">
          <Label styleClass="section-head" text="%display.round.section"/>
          <GridPane styleClass="form">
            <Label styleClass="field-label" text="%column.round" labelFor="$roundChoice"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="roundChoice" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label styleClass="field-label" text="%display.minutes" labelFor="$minutes"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Spinner fx:id="minutes" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          </GridPane>
          <Label fx:id="roundStatus"/>
          <HBox styleClass="view-actions">
            <Button fx:id="startButton" minWidth="-Infinity" text="%display.start" onAction="#start"/>
            <Button fx:id="resetButton" minWidth="-Infinity" text="%display.reset" onAction="#reset"/>
            <Button fx:id="roundButton" minWidth="-Infinity" text="%display.show.round" onAction="#showRound"/>
          </HBox>
        </VBox>
        <VBox styleClass="slot">
          <Label styleClass="section-head" text="%display.ranking"/>
          <Label fx:id="rankingStatus" wrapText="true"/>
          <HBox styleClass="view-actions">
            <Button fx:id="rankingButton" minWidth="-Infinity" text="%display.show.ranking"
                    onAction="#showRanking"/>
            <Button fx:id="revealButton" minWidth="-Infinity" onAction="#reveal"/>
            <Button fx:id="hideButton" minWidth="-Infinity" text="%display.hide" onAction="#hideAll"/>
          </HBox>
        </VBox>
      </VBox>
    </VBox>
  </ScrollPane>
</VBox>
