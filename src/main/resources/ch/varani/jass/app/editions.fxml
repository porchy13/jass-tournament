<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<!-- The start view: the editions of the data folder (EditionsController). -->
<VBox styleClass="view" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
  <HBox styleClass="toolbar">
    <Button fx:id="newButton" minWidth="-Infinity" styleClass="primary" text="%editions.new" onAction="#newEdition"/>
    <Separator orientation="VERTICAL"/>
    <Button fx:id="openButton" styleClass="icon-button" onAction="#open"/>
    <Button fx:id="duplicateButton" styleClass="icon-button" onAction="#duplicate"/>
    <Button fx:id="importButton" styleClass="icon-button" onAction="#importEdition"/>
    <Button fx:id="deleteButton" styleClass="icon-button" onAction="#delete"/>
  </HBox>
  <VBox styleClass="view-body" VBox.vgrow="ALWAYS">
    <HBox styleClass="view-head">
      <Label styleClass="title-view" text="%editions.title"/>
      <Label fx:id="count" styleClass="caption"/>
    </HBox>
    <Label fx:id="unreadable" styleClass="warning"/>
    <TableView fx:id="table" styleClass="panel" VBox.vgrow="ALWAYS">
      <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
      <columns>
        <TableColumn fx:id="nameColumn" text="%column.name" prefWidth="420"/>
        <TableColumn fx:id="modeColumn" text="%column.mode" prefWidth="160"/>
        <TableColumn fx:id="dateColumn" text="%column.date" prefWidth="160" styleClass="number"/>
      </columns>
    </TableView>
  </VBox>
</VBox>
