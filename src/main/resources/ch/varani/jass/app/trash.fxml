<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<!-- The trash: the deleted editions (TrashController). -->
<VBox styleClass="view" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
  <HBox styleClass="toolbar">
    <Button fx:id="restoreButton" text="%trash.restore" onAction="#restore"/>
    <Separator orientation="VERTICAL"/>
    <Button fx:id="emptyButton" styleClass="danger" text="%trash.empty.action" onAction="#empty"/>
  </HBox>
  <VBox styleClass="view-body" VBox.vgrow="ALWAYS">
    <HBox styleClass="view-head">
      <Label styleClass="title-view" text="%trash.title"/>
      <Label fx:id="count" styleClass="caption"/>
    </HBox>
    <TableView fx:id="table" styleClass="panel" VBox.vgrow="ALWAYS">
      <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
      <placeholder>
        <VBox styleClass="empty-state"><Label text="%trash.empty"/></VBox>
      </placeholder>
      <columns>
        <TableColumn fx:id="nameColumn" text="%column.name" prefWidth="420"/>
        <TableColumn fx:id="dateColumn" text="%column.date" prefWidth="160" styleClass="number"/>
      </columns>
    </TableView>
  </VBox>
</VBox>
