<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<!--
  The directory of the persons (DirectoryController): the persons at the left, the selected person in the detail
  panel, the actions on the selection in the toolbar.
-->
<VBox styleClass="view" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
  <HBox fx:id="toolbar" styleClass="toolbar">
    <Button fx:id="newButton" minWidth="-Infinity" styleClass="primary" text="%directory.new" onAction="#newPerson"/>
    <Separator orientation="VERTICAL"/>
    <Button fx:id="mergeButton" styleClass="icon-button" onAction="#merge"/>
    <Button fx:id="emailsButton" styleClass="icon-button" onAction="#copyEmails"/>
    <Button fx:id="phonesButton" styleClass="icon-button" onAction="#copyPhones"/>
    <Button fx:id="importButton" styleClass="icon-button" onAction="#importPersons"/>
    <Button fx:id="exportButton" styleClass="icon-button" onAction="#export"/>
    <Region HBox.hgrow="ALWAYS"/>
    <ChoiceBox fx:id="editionFilter"/>
    <TextField fx:id="search" styleClass="search"/>
  </HBox>
  <Label fx:id="unavailable" styleClass="warning" text="%directory.unavailable" wrapText="true"/>
  <StackPane fx:id="body" VBox.vgrow="ALWAYS">
    <SplitPane fx:id="split">
      <VBox styleClass="view-body, panel">
        <HBox styleClass="view-head">
          <Label styleClass="title-view" text="%directory.title"/>
          <Label fx:id="count" styleClass="caption"/>
        </HBox>
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
          <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
          <columns>
            <TableColumn fx:id="lastColumn" text="%column.last.name"/>
            <TableColumn fx:id="firstColumn" text="%column.first.name"/>
            <TableColumn fx:id="emailColumn" text="%column.email"/>
            <TableColumn fx:id="phoneColumn" text="%column.phone"/>
            <TableColumn fx:id="statusColumn" text="%column.status"/>
          </columns>
        </TableView>
      </VBox>
      <ScrollPane fx:id="detail" styleClass="detail, panel" fitToWidth="true">
        <VBox styleClass="panel-body">
          <HBox styleClass="view-head">
            <Label fx:id="personTitle" styleClass="title-panel" wrapText="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeDetail" styleClass="icon-button"/>
          </HBox>
          <GridPane styleClass="form">
            <Label styleClass="field-label" text="%form.first.name" labelFor="$firstField"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="firstField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label styleClass="field-label" text="%form.last.name" labelFor="$lastField"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="lastField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label styleClass="field-label" text="%form.email" labelFor="$emailField"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label styleClass="field-label" text="%form.phone" labelFor="$phoneField"
                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="phoneField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label styleClass="field-label" text="%form.notes" labelFor="$notesField"
                   GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="notesField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label styleClass="field-label" text="%form.status" labelFor="$statusBox"
                   GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <ChoiceBox fx:id="statusBox" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
          </GridPane>
          <Label fx:id="problem" styleClass="error" wrapText="true"/>
          <ButtonBar>
            <buttons>
              <Button fx:id="eraseButton" text="%directory.erase" onAction="#erase" ButtonBar.buttonData="OTHER"
                      ButtonBar.buttonUniformSize="false"/>
              <Button fx:id="saveButton" text="%directory.save" onAction="#save" defaultButton="true"
                      ButtonBar.buttonData="OK_DONE" ButtonBar.buttonUniformSize="false"/>
            </buttons>
          </ButtonBar>
          <Label styleClass="section-head" text="%directory.participations"/>
          <ListView fx:id="participations" styleClass="proposals"/>
          <HBox styleClass="buttons">
            <Button fx:id="deleteButton" styleClass="danger" text="%directory.delete" onAction="#delete"/>
          </HBox>
        </VBox>
      </ScrollPane>
    </SplitPane>
  </StackPane>
</VBox>
