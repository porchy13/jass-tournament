<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<!-- The import of persons into the directory, with its preview (ImportController). -->
<VBox styleClass="view" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
  <VBox styleClass="view-body, panel" VBox.vgrow="ALWAYS">
    <Label styleClass="title-view" text="%import.title"/>
    <HBox styleClass="buttons">
      <Button fx:id="fileButton" text="%import.file" onAction="#chooseFile"/>
      <Label styleClass="field-label" text="%import.paste"/>
    </HBox>
    <TextArea fx:id="text" prefRowCount="5"/>
    <HBox styleClass="buttons">
      <Label styleClass="field-label" text="%import.separator" labelFor="$separatorBox"/>
      <ChoiceBox fx:id="separatorBox"/>
      <CheckBox fx:id="headerBox" text="%import.header"/>
    </HBox>
    <GridPane styleClass="form">
      <Label styleClass="field-label" text="%form.first.name" labelFor="$firstBox"
             GridPane.rowIndex="0" GridPane.columnIndex="0"/>
      <ChoiceBox fx:id="firstBox" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
      <Label styleClass="field-label" text="%form.last.name" labelFor="$lastBox"
             GridPane.rowIndex="0" GridPane.columnIndex="2"/>
      <ChoiceBox fx:id="lastBox" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
      <Label styleClass="field-label" text="%form.email" labelFor="$emailBox"
             GridPane.rowIndex="1" GridPane.columnIndex="0"/>
      <ChoiceBox fx:id="emailBox" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
      <Label styleClass="field-label" text="%form.phone" labelFor="$phoneBox"
             GridPane.rowIndex="1" GridPane.columnIndex="2"/>
      <ChoiceBox fx:id="phoneBox" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
    </GridPane>
    <HBox styleClass="view-head">
      <Label styleClass="section-head" text="%import.preview"/>
      <Label fx:id="summary" styleClass="caption"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
      <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
      <placeholder>
        <VBox styleClass="empty-state"><Label text="%import.empty"/></VBox>
      </placeholder>
    </TableView>
    <CheckBox fx:id="duplicatesBox" text="%import.duplicates"/>
    <ButtonBar styleClass="view-actions">
      <buttons>
        <Button fx:id="cancelButton" text="%button.cancel" onAction="#cancel" cancelButton="true"
                ButtonBar.buttonData="CANCEL_CLOSE"/>
        <Button fx:id="importButton" text="%import.confirm" onAction="#importPersons" defaultButton="true"
                ButtonBar.buttonData="OK_DONE"/>
      </buttons>
    </ButtonBar>
  </VBox>
</VBox>
