<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<!--
  The main window (MainController, DESIGN.md §6): the menu bar (global on macOS), the side navigation and the view of
  the moment in a split pane, and the status bar.
-->
<BorderPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
  <top>
    <MenuBar fx:id="menuBar">
      <Menu text="%menu.file">
        <MenuItem fx:id="newItem" text="%menu.new.edition" onAction="#createNew" accelerator="Shortcut+N"/>
        <MenuItem fx:id="saveItem" text="%menu.save" onAction="#saveView" accelerator="Shortcut+S"/>
        <SeparatorMenuItem/>
        <MenuItem fx:id="importItem" text="%menu.import" onAction="#importEdition" accelerator="Shortcut+O"/>
        <MenuItem fx:id="exportItem" text="%menu.export" onAction="#exportEdition" accelerator="Shortcut+E"/>
        <MenuItem fx:id="deleteItem" text="%menu.delete" onAction="#deleteEdition"/>
        <SeparatorMenuItem/>
        <MenuItem fx:id="backupItem" text="%menu.backup" onAction="#backUp"/>
        <SeparatorMenuItem fx:id="settingsSeparator"/>
        <MenuItem fx:id="settingsItem" text="%menu.settings.mac" onAction="#showSettings" accelerator="Shortcut+Comma"/>
        <SeparatorMenuItem fx:id="quitSeparator"/>
        <MenuItem fx:id="quitItem" text="%menu.quit" onAction="#quit" accelerator="Shortcut+Q"/>
      </Menu>
      <Menu text="%menu.view">
        <MenuItem fx:id="listItem" text="%menu.editions" onAction="#showList" accelerator="Shortcut+1"/>
        <MenuItem fx:id="directoryItem" text="%menu.directory" onAction="#showDirectory" accelerator="Shortcut+2"/>
        <MenuItem fx:id="trashItem" text="%menu.trash" onAction="#showTrash" accelerator="Shortcut+3"/>
        <SeparatorMenuItem/>
        <MenuItem fx:id="searchItem" text="%menu.search" onAction="#search" accelerator="Shortcut+F"/>
        <CheckMenuItem fx:id="sidebarItem" text="%menu.sidebar" selected="true" accelerator="Shortcut+B"/>
        <SeparatorMenuItem/>
        <MenuItem fx:id="displayItem" text="%menu.display" onAction="#openDisplay"/>
      </Menu>
      <Menu fx:id="toolsMenu" text="%menu.tools">
        <MenuItem fx:id="optionsItem" text="%menu.settings" onAction="#showSettings" accelerator="Shortcut+Comma"/>
      </Menu>
    </MenuBar>
  </top>
  <center>
    <SplitPane fx:id="split">
      <VBox fx:id="sidebar" styleClass="sidebar, panel"/>
      <StackPane fx:id="viewArea" styleClass="content"/>
    </SplitPane>
  </center>
  <bottom>
    <HBox styleClass="status-bar">
      <Label fx:id="saveState">
        <graphic><Circle fx:id="saveDot" radius="3.5" styleClass="status-dot"/></graphic>
      </Label>
      <Label fx:id="selection"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label fx:id="notice"/>
    </HBox>
  </bottom>
</BorderPane>
